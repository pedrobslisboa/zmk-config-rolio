#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>

// Helpful macros borrowed from AndrewMSHowe
#define ___ &trans

// Layer numbers for use by the keymap & macros

#define DEFAULT 0
#define NUMBER  1
#define FN  2
#define HOTKEY  3


// Allow tap-then-hold to repeat the tap key (e.g., tap BSPC + hold BSPC = repeat delete)
// instead of triggering the layer/modifier. Only applies within 200ms after a tap.
&lt {
    quick-tap-ms = <200>;
};

&mt {
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        // Right thumb 3 (right of BSPC): tap 1x = toggle NUMBER, tap 2x = toggle FN
        layer_toggle: layer_toggle {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&tog 1>, <&tog 2>;
        };

        // Right thumb 1 (left of BSPC): tap/hold = Cmd (LGUI), 2x tap = Alt (LALT)
        // Cmd combos: press-and-hold R1 while pressing letter (e.g., Cmd+C).
        // Opt combos: tap R1 twice, hold on 2nd tap, then press letter.
        gui_alt: gui_alt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows_default_layer {
            label = "DEFAULT";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
       &kp ESC        &kp Q            &kp W           &kp E           &kp R           &kp T     /*|                                 |*/  &kp Y          &kp U           &kp I           &kp O           &kp P          &kp NON_US_BSLH
       &kp TAB        &kp A            &kp S           &kp D           &kp F           &kp G     /*├─────────────╮     ╭─────────────┤*/  &kp H          &kp J           &kp K           &kp L           &kp SEMI       &kp SQT
       &kp LSHIFT     &kp Z            &kp X           &kp C           &kp V           &kp B                                              &kp N          &kp M           &kp COMMA       &kp DOT         &kp FSLH       &kp LALT
/* ╰───────────────┴───────────────┤*/                                 &kp LCTRL       &lt 1  RETURN  &lt 3 SPACE            &gui_alt      &lt 2 BSPC     &layer_toggle //├───────────────┴───────────────╯
//                                 ╰───────────────┴───────────────┴───────────────┴───────────────┴─────────────╯     ╰─────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
            >;
        };

 

        windows_symbols_layer {
            label = "NUMBER";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
       &kp UNDER       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5    /*|                                 |*/  &kp FSLH       &kp N7          &kp N8          &kp N9          &kp N0          &kp EQUAL
       &kp LBKT        &kp EXCL        &kp AT          &mkp RCLK       &mkp LCLK       &kp PRCNT /*├─────────────╮     ╭─────────────┤*/  &kp STAR       &kp N4          &kp N5          &kp N6          &kp N0          &kp MINUS
       &kp PSCRN       &kp LG(DOT)     &kp LEFT_BRACE  &kp RIGHT_BRACE &kp PIPE        &kp EQUAL                                          &kp BSLH       &kp N1          &kp N2          &kp N3          &kp BACKSLASH   &kp PLUS
/* ╰───────────────┴───────────────┤*/                                 ___             ___             ___                 &kp LSHIFT     &kp DEL        &kp EQUAL                  //├───────────────┴───────────────╯
//                                 ╰───────────────┴───────────────┴───────────────┴───────────────┴─────────────╯     ╰─────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
            >;
        };

        numpad_layer {
            label = "FN";
            
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
       &kp F11         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5    /*|                                 |*/  &kp F6         &kp F7          &kp F8          &kp F9          &kp F10          &kp F12 
       &kp CAPSLOCK    &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT /*├─────────────╮     ╭─────────────┤*/  &kp CARET      &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT        &kp MINUS
       ___             ___             &kp LEFT_BRACE  &kp RIGHT_BRACE &kp PIPE        &kp EQUAL                                          &kp PRCNT      &kp N1          &mt COMMA N2    &mt DOT N3      &kp KP_DIVIDE    &kp KP_MULTIPLY
/* ╰───────────────┴───────────────┤*/                                 &kp LGUI        &kp LALT      &kp LA(SPACE)            ___            ___         &kp N0                                    //├───────────────┴───────────────╯
//                                 ╰───────────────┴───────────────┴───────────────┴───────────────┴─────────────╯     ╰─────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
            >;
      };



      mouse_layer {
            label = "MOUSE";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬────────────────╮                                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
      &out OUT_TOG     ___              ___             ___             ___             ___      /*|                                 |*/   ___            &msc SCRL_UP    &mmv MOVE_UP     &msc SCRL_DOWN  ___              &soft_off
      ___              &bl BL_TOG       &bl BL_INC      &bl BL_DEC      ___             ___      /*├─────────────╮     ╭─────────────┤*/   ___            &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT ___              ___
      ___              ___              ___             ___             ___             ___                                                &msc SCRL_LEFT ___             ___              ___             &msc SCRL_RIGHT  ___
/* ╰───────────────┴───────────────┤*/                                 &mkp LCLK       &mkp RCLK       &mkp MCLK           ___            ___            ___              //├───────────────┴───────────────╯
//                                 ╰───────────────┴───────────────┴───────────────┴────────────────┴─────────────╯     ╰─────────────┴───────────────┴───────────────┴───────────────┴───────────────╯
            >;
        };

    

    };

};
